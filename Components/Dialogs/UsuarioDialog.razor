@using Ferocity.Models
@using Ferocity.Services
@inject UsuarioService UsuarioService
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_esValido">
            <MudStack Spacing="2">
                <MudTextField T="string" Label="Usuario" @bind-Value="Usuario.Usuario" Required="true" RequiredError="Ingresa el nombre de usuario." MaxLength="45" Counter="45" />
                <MudTextField T="string" Label="Nombre" @bind-Value="Usuario.Nombre" MaxLength="150" Counter="150" />
                <MudTextField T="string" Label="Contraseña" @bind-Value="Usuario.Password" InputType="InputType.Password" Required="true" RequiredError="Ingresa la contraseña." MaxLength="14" Counter="14" />
                <MudSelect T="int?" Label="Nivel" @bind-Value="Usuario.Nivel" Required="true" RequiredError="Selecciona un nivel.">
                    <MudSelectItem T="int?" Value="1">Administrador</MudSelectItem>
                    <MudSelectItem T="int?" Value="2">Coatch</MudSelectItem>
                    <MudSelectItem T="int?" Value="3">Alumno</MudSelectItem>
                </MudSelect>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Guardar">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Tusuario Usuario { get; set; } = new() { Nivel = 3 };

    private MudForm _form = null!;
    private bool _esValido;

    private void Cancelar() => MudDialog.Cancel();

    private async Task Guardar()
    {
        await _form.Validate();
        if (!_esValido)
            return;

        MudDialog.Close(DialogResult.Ok(Usuario));
    }
}

